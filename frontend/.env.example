# Copy to .env.local for local development.
# In production (Vercel), set these in Project Settings → Environment Variables.

# Turso (hosted SQLite) connection.
# Create a database:  turso db create accounting-g12
# Get the URL:        turso db show accounting-g12 --url
# Create a token:     turso db tokens create accounting-g12
DATABASE_URL=libsql://your-db-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Optional: email that always gets the admin role on signup.
# If unset, the FIRST registered account automatically becomes admin.
# ADMIN_EMAIL=you@example.com
