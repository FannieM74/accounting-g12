{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "https://acctg12-api.vercel.app/" },
    { "source": "/api/(.*)", "destination": "https://acctg12-api.vercel.app/api/$1" },
    { "source": "/ui/static/(.*)", "destination": "https://acctg12-api.vercel.app/ui/static/$1" },
    { "source": "/favicon.ico", "destination": "https://acctg12-api.vercel.app/favicon.ico" },
    { "source": "/ui", "destination": "https://acctg12-api.vercel.app/ui/" },
    { "source": "/ui/(.*)", "destination": "https://acctg12-api.vercel.app/ui/$1" }
  ]
}
